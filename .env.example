# 复制成 .env 后填好。缺失必填项时 docker compose 会直接报错（不许静默用默认值）。

# 必填：openssl rand -hex 32 / openssl rand -hex 16
JWT_SECRET=
AGENT_TOKEN_PEPPER=

# 对外端口（web 容器）
HTTP_PORT=8080

# 单个附件上限（默认 20 MiB）。0 = 不限制，也支持 200MiB 写法。
# 放开时记得同步前置代理的请求体限制。
# MAX_ATTACHMENT_BYTES=0

# 前后端**真跨域**时才需要（客户端放 CDN）。本 compose 由 web 反代，同源，留空即可。
# 多个来源用逗号分隔；**不支持 `*`**（请求带 Authorization，通配符会泄露 token）。
# CORS_ORIGINS=https://app.example.com

# 公网 TLS（docker compose --profile tls up -d）
# AGENTLINK_DOMAIN=chat.example.com
# HTTPS_PORT=443

# 服主 id（可选）：全权限工具只对这个账号开放。留空则回退到"建 agent 的人"。
# HOST_OWNER_ID=u_01...

# 工具告警收件人（可选）：逗号分隔。留空 = 全部人类管理员。
# TOOL_ALERT_USER_IDS=u_01...,u_02...

# 审计日志保留天数（默认 180）。0 = 永不删除。
# AUDIT_RETENTION_DAYS=180

LOG_LEVEL=info
