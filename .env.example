# ---- 必需 ----
# 生成：openssl rand -hex 32
JWT_SECRET=
# 生成：openssl rand -hex 16
AGENT_TOKEN_PEPPER=

# ---- 可选 ----
LOG_LEVEL=info
# 本地起在 8080 而不是 80（避免要 root）
# HTTP_PORT=8080
# HTTPS_PORT=8443

# M11 插件钩子（容器内的绝对路径或相对路径）
# HOOKS_MODULE=/app/hooks/example.mjs

# 单个附件上限（默认 20 MiB）。0 = 不限制（此时磁盘就是上限），也支持 200MiB 写法。
# 放开时记得同步前置代理的请求体限制（Nginx client_max_body_size）。
# MAX_ATTACHMENT_BYTES=0
