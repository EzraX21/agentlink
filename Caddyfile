# Caddy：反向代理 + 自动 TLS（本地用 :80，公网部署时把站点地址换成你的域名，
# Caddy 会自动申请证书 —— 不需要手写 certbot）。
#
# 注意：WS 升级由 Caddy 自动透传，不需要额外配置。

:80 {
	encode zstd gzip

	# 健康检查**必须**透传给后端：协议 §1 要求返回 {"ok":true}，
	# 而 Caddy 的 `respond /healthz 200` 只回空 body —— 会让任何按 JSON 断言的
	# 探活（以及 M10 验收）失败。Docker HEALTHCHECK 打的是容器内端口，不经过这里。

	# WebSocket
	@ws {
		path /ws
		header Connection *Upgrade*
		header Upgrade websocket
	}
	reverse_proxy @ws server:3000

	# 其余（/api、/assets、SPA 路由）都交给后端：
	# 服务端自己托管构建好的 Web 产物 + SPA 兜底（PUBLIC_DIR）
	reverse_proxy server:3000

	# 访问日志：故意记到文件而不是 stdout，方便排查；
	# token 只在 WS 帧体/HTTP body 里，不会出现在 URL，所以日志里不会有凭证。
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format console
	}
}