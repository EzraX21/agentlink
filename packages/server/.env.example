# ---- 必需（缺失即启动失败，不许用默认值）----
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 16
AGENT_TOKEN_PEPPER=

# ---- 可选 ----
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
DATABASE_PATH=./data/agentlink.db
UPLOADS_DIR=./data/uploads
AUTO_MIGRATE=true

# 静态资源目录（Docker 里指向构建好的 web 产物；本地留空由 Vite 代理）
# PUBLIC_DIR=./public

# M11 插件钩子（本地 ESM 模块路径）
# HOOKS_MODULE=./hooks/example.mjs
