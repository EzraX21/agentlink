{
  "name": "@agentlink/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AgentLink server: Fastify 5 + ws + better-sqlite3.",
  "license": "GPL-3.0-or-later",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@agentlink/protocol": "workspace:*",
    "@fastify/cors": "11.4.3",
    "@fastify/multipart": "10.1.9",
    "@fastify/static": "10.1.11",
    "@node-rs/argon2": "2.2.2",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "jose": "6.2.17",
    "pino": "10.4.0",
    "ulid": "3.0.2",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
