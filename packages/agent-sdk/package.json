{
  "name": "@agentlink/agent-sdk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AgentLink agent SDK: connect / subscribe / onMessage / context / send / stream.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentlink/protocol": "workspace:*",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
