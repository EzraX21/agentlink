{
  "name": "agentlink",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "acceptance": "node scripts/acceptance/run.mjs",
    "dev:server": "pnpm --filter @agentlink/server dev",
    "dev:web": "pnpm --filter @agentlink/web dev",
    "e2e:install": "PLAYWRIGHT_BROWSERS_PATH=../.runtime/pw-browsers playwright-core install chromium"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@types/ws": "8.18.2",
    "pixelmatch": "^8.0.0",
    "playwright-core": "1.65.1",
    "pngjs": "^7.0.0",
    "typescript": "5.9.3",
    "ws": "8.23.0"
  },
  "license": "GPL-3.0-or-later"
}
